# Copy to web/.env (git-ignored). Server-side only: never prefix secrets with VITE_.

# BaoBao's AI voice (/api/voice). Get a key at https://cloud.near.ai
# (or claim $10 of credits at https://nearbuilders.org/dashboard).
# Without a key the panda still talks, from canned lines that use the real chain data.
NEAR_AI_API_KEY=
# Any chat model NEAR AI Cloud serves (GET https://cloud-api.near.ai/v1/models)
NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# Optional overrides for the browser bundle
# VITE_CONTRACT_ID=totem-grumbo.testnet
# VITE_DAO_ID=totem-tribe.sputnik-v2.testnet
# VITE_RPC_URL=https://your-rpc

# Gasless guests (/api/guest, /api/relay). The relayer pays gas for guests.
# Defaults to totem-grumbo-relay.testnet with its key read from ~/.near-credentials.
# RELAYER_ACCOUNT_ID=totem-grumbo-relay.testnet
# RELAYER_PRIVATE_KEY=ed25519:...

# Telegram bot (npm run bot). Create one with @BotFather (/newbot) and paste its token.
# Without a token, `npm run bot` runs in dry-run mode and prints what it would send.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Where the bot's links point (rescue, tribe, farm). Must be https:// for Telegram
# buttons; otherwise the links are written into the message text.
# APP_URL=https://your-hosted-app
