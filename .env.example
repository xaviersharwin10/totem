# Copy to .env (git-ignored) and fill in. No private keys here: near-cli keeps
# keys in ~/.near-credentials (legacy keychain) on the machine that deploys.

NETWORK=testnet
# Account the TOTEM contract is deployed to
CONTRACT_ID=totem-example.testnet
# Holds the genesis supply and owns the Totem NFT until it is transferred to the DAO
OWNER_ID=totem-example-owner.testnet
# Sputnik DAO account (filled in after scripts/create-dao)
DAO_ID=
